// Schema pentru platforma de recrutare: candidati, angajatori, skill-uri, conversatii.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  CANDIDATE
  EMPLOYER
}

enum Disponibilitate {
  IMEDIATA
  SUB_O_LUNA
  PESTE_O_LUNA
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTERED
}

enum NotificationTip {
  MESAJ_NOU
  OFERTA_NOUA
  OFERTA_RASPUNS
  RADAR_POST
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String?
  role           Role?
  emailVerificat Boolean  @default(false)
  isAdmin        Boolean  @default(false)
  telefon        String?  @unique
  notificariEmail Boolean @default(true)
  notificariPush  Boolean @default(false)
  pushToken       String?  // token Expo pentru notificări push pe telefon
  emailuriDigest  Boolean @default(false)
  newsletterEmail Boolean @default(false)
  termeniAcceptatiLa DateTime?
  abonamentTip    String?   // GOLD | PLATINUM | UNLIMITED (null = fără abonament / gratuit)
  abonamentExpira DateTime?
  // Date de facturare (pentru factura emisă la plata abonamentului). Firmele completează CUI-ul.
  facturareDenumire String? // nume persoană sau denumire firmă (pe factură)
  facturareCui      String? // CUI/CIF cumpărător (doar firme)
  facturareAdresa   String? // adresa de facturare
  ultimaActivitate DateTime? // pentru statusul online („activ acum" / „deconectat")
  createdAt      DateTime @default(now())

  candidateProfile CandidateProfile?
  employerProfile  EmployerProfile?
  tokens           Token[]
  notifications    Notification[]
  reportsMade      Report[]  @relation("ReportsMade")
  reportsReceived  Report[]  @relation("ReportsReceived")
  blocksMade       Block[]   @relation("BlocksMade")
  blocksReceived   Block[]   @relation("BlocksReceived")
  testimoniale     Testimonial[]
}

// Testimonial / recenzie despre platformă — moderat (aprobat de admin înainte de afișare).
model Testimonial {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  nume      String
  rol       String   // "CANDIDATE" | "EMPLOYER"
  rating    Int      // 1..5
  text      String
  aprobat   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([aprobat])
}

// Articol educativ / noutate din piața muncii — rezumat + link la sursă (fără copiere).
// La lansare, se pot genera automat zilnic (rezumat AI + sursă oficială).
model Articol {
  id        String   @id @default(cuid())
  titlu     String
  rezumat   String
  sursaNume String
  sursaUrl  String
  categorie String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Raportare utilizator (abuz, spam etc.) — vizibilă adminului.
model Report {
  id           String   @id @default(cuid())
  reporterId   String
  reporter     User     @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUserId String
  target       User     @relation("ReportsReceived", fields: [targetUserId], references: [id], onDelete: Cascade)
  motiv        String
  detalii      String?
  rezolvat     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([rezolvat])
}

// Blocare utilizator — împiedică mesajele între cei doi.
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model Token {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tip      String
  token    String   @unique
  expiraLa DateTime
  creatLa  DateTime @default(now())
}

model CandidateProfile {
  id              String          @id @default(cuid())
  userId          String          @unique
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  numeComplet     String
  locatie         String
  remote          Boolean         @default(false)
  aniExperienta   Int
  titluCurent     String
  bio             String?
  salariuMinim    Int?
  salariuMaxim    Int?
  pozaFisier      String? // numele fișierului pozei de profil (opțional)
  varsta          Int? // vârsta (opțional) — derivată din dataNasterii dacă e completată
  dataNasterii    DateTime? // data nașterii (opțional)
  sex             String? // opțional: „Masculin” / „Feminin” / „Altul”
  disponibilitate Disponibilitate @default(SUB_O_LUNA)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  skills        CandidateSkill[]
  conversations Conversation[]
  cvFiles       CvFile[]
  profileViews  ProfileView[]
  savedBy       SavedCandidate[]
}

model CvFile {
  id          String   @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  eticheta    String
  fisierNume  String
  createdAt   DateTime @default(now())
}

model EmployerProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  numeCompanie   String
  industrie      String?
  locatie        String?
  marimeCompanie String?
  website        String?
  linkedin       String?
  anFondare      Int?
  beneficii      String?
  descriere      String?
  cautamGeneral  String?
  domeniiInteres String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversations Conversation[]
  profileViews  ProfileView[]
  posturi       Post[]
  savedCandidates SavedCandidate[]
  savedSearches SavedSearch[]
}

// Un "post" = o poziție deschisă pe care compania recrutează. Nu e anunț public la
// care candidații aplică (platforma rămâne cu căutare directă); e informativ pentru
// candidați și un instrument de căutare țintită pentru angajator.
model Post {
  id            String          @id @default(cuid())
  employerId    String
  employer      EmployerProfile @relation(fields: [employerId], references: [id], onDelete: Cascade)
  titlu         String
  domeniuSlug   String?
  skills        String? // skill-uri cheie, separate prin virgulă
  experientaMin Int?
  experientaMax Int?
  salariuMin    Int?
  salariuMax    Int?
  locatie       String?
  remote        Boolean         @default(false)
  descriere     String?
  activ         Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([employerId])
}

model Skill {
  id   String @id @default(cuid())
  nume String @unique

  candidates CandidateSkill[]
}

model CandidateSkill {
  candidateId String
  skillId     String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skill       Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([candidateId, skillId])
}

model Conversation {
  id          String   @id @default(cuid())
  employerId  String
  candidateId String
  employer    EmployerProfile  @relation(fields: [employerId], references: [id], onDelete: Cascade)
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  employerCititLa DateTime? // când a citit ultima dată angajatorul conversația (pentru „văzut")
  candidatCititLa DateTime? // când a citit ultima dată candidatul conversația (pentru „văzut")

  messages Message[]
  offers   JobOffer[]

  @@unique([employerId, candidateId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  trimisDe       Role
  continut       String?
  atasamentNume  String?
  createdAt      DateTime     @default(now())
}

model DocumentAdmin {
  id         String   @id @default(cuid())
  eticheta   String
  fisierNume String
  createdAt  DateTime @default(now())
}

model Notification {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tip       NotificationTip
  titlu     String
  continut  String?
  link      String
  entityId  String?
  citit     Boolean         @default(false)
  createdAt DateTime        @default(now())

  @@index([userId, citit])
}

model JobOffer {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  titluPost      String
  descriere      String
  salariu        Int?         // salariul curent pe masă (poate fi actualizat la re-contraofertare)
  salariuContra  Int?         // salariul propus de candidat la contraofertă (valabil în status COUNTERED)
  locatie        String?
  status         OfferStatus  @default(PENDING)
  inchisDe       Role?        // cine a mutat oferta din PENDING: CANDIDATE (accept/refuz) sau EMPLOYER (retragere)
  createdAt      DateTime     @default(now())
  raspunsLa      DateTime?
  updatedAt      DateTime     @updatedAt

  @@index([conversationId])
}

model ProfileView {
  id          String           @id @default(cuid())
  candidateId String
  employerId  String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  employer    EmployerProfile  @relation(fields: [employerId], references: [id], onDelete: Cascade)
  tip         String           @default("PROFIL")
  viewCount   Int              @default(1)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([employerId, candidateId, tip])
}

// Căutare salvată de un angajator — criterii reutilizabile pentru căutarea de candidați.
model SavedSearch {
  id            String          @id @default(cuid())
  employerId    String
  employer      EmployerProfile @relation(fields: [employerId], references: [id], onDelete: Cascade)
  nume          String
  skills        String?
  locatie       String?
  experientaMin Int?
  experientaMax Int?
  bugetMin      Int?
  bugetMax      Int?
  domeniu       String?
  createdAt     DateTime        @default(now())

  @@index([employerId])
}

// Candidat salvat de un angajator (shortlist), cu notă internă privată.
model SavedCandidate {
  id          String           @id @default(cuid())
  employerId  String
  candidateId String
  employer    EmployerProfile  @relation(fields: [employerId], references: [id], onDelete: Cascade)
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  notita      String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([employerId, candidateId])
  @@index([employerId])
}
